[Desktop Entry]
Type=Application
Name=Mocha Stack Optimizer
GenericName=Atualizador Mocha de Kernel e Driver
Comment=Mostra versões instaladas/disponíveis e permite atualizar ou reinstalar/recasar a stack completa
Exec=/usr/local/bin/mocha-stack-optimizer
Icon=system-software-update
Terminal=false
Categories=System;Settings;
StartupNotify=true
