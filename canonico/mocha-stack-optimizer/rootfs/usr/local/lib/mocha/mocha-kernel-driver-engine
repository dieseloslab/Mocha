#!/usr/bin/env bash
set -Eeuo pipefail
export LC_ALL=C

MODE="${1:-check}"
PACMAN_CONF="/etc/pacman.conf"
CACHY_KEY="F3B607488DB35A47"

log() { printf '\n[%s] %s\n' "$(date '+%F %T')" "$*"; }
fail() { printf '[FALHA] %s\n' "$*" >&2; exit 1; }
need_cmd() { command -v "$1" >/dev/null 2>&1 || fail "Comando ausente: $1"; }

assert_root() {
  [ "$(id -u)" = "0" ] || fail "Use com sudo/pkexec: $0 $MODE"
}

assert_no_permanent_cachyos_repo() {
  if grep -qE '^[[:space:]]*\[cachyos' "$PACMAN_CONF"; then
    grep -nE '^[[:space:]]*\[cachyos' "$PACMAN_CONF" || true
    fail "Repo CachyOS permanente detectado. Proibido na Mocha."
  fi
}

ensure_cachy_key() {
  pacman-key --list-keys "$CACHY_KEY" >/dev/null 2>&1 && return 0
  pacman-key --recv-keys "$CACHY_KEY" --keyserver hkps://keyserver.ubuntu.com || pacman-key --recv-keys "$CACHY_KEY" --keyserver hkp://keyserver.ubuntu.com:80
  pacman-key --lsign-key "$CACHY_KEY"
}

cpu_supports() {
  local level="$1"
  /lib/ld-linux-x86-64.so.2 --help 2>/dev/null | grep -q "${level}.*supported"
}

candidate_profiles() {
  if cpu_supports 'x86-64-v4'; then
    printf '%s\n' 'x86_64_v4|cachyos-v4|x86_64_v4|x86_64 x86_64_v4'
    printf '%s\n' 'x86_64_v3|cachyos-v3|x86_64_v3|x86_64 x86_64_v3'
    printf '%s\n' 'x86_64|cachyos|x86_64|x86_64'
  elif cpu_supports 'x86-64-v3'; then
    printf '%s\n' 'x86_64_v3|cachyos-v3|x86_64_v3|x86_64 x86_64_v3'
    printf '%s\n' 'x86_64|cachyos|x86_64|x86_64'
  else
    printf '%s\n' 'x86_64|cachyos|x86_64|x86_64'
  fi
}

cleanup_sync_dbs() {
  rm -f /var/lib/pacman/sync/cachyos.db /var/lib/pacman/sync/cachyos.files /var/lib/pacman/sync/cachyos-v3.* /var/lib/pacman/sync/cachyos-v4.* /var/lib/pacman/sync/cachyos-core-v3.* /var/lib/pacman/sync/cachyos-extra-v3.* /var/lib/pacman/sync/cachyos-core-v4.* /var/lib/pacman/sync/cachyos-extra-v4.* >/dev/null 2>&1 || true
}

make_temp_pacman() {
  local tmpdir="$1"
  local repo="$2"
  local repo_path="$3"
  local arch_line="$4"
  local tmpconf="$tmpdir/pacman.conf"
  local mirror="$tmpdir/cachyos-mirrorlist"

  printf '%s\n' "Server = https://cdn77.cachyos.org/repo/${repo_path}/"'$repo' "Server = https://mirror.cachyos.org/repo/${repo_path}/"'$repo' > "$mirror"

  {
    printf '%s\n' '[options]'
    printf '%s\n' 'HoldPkg = pacman glibc'
    printf 'Architecture = %s\n' "$arch_line"
    printf '%s\n' 'CheckSpace'
    printf '%s\n' 'SigLevel = Required DatabaseOptional'
    printf '%s\n' 'LocalFileSigLevel = Optional'
    printf '%s\n' 'ParallelDownloads = 5'
    printf '\n'
    printf '%s\n' '[core]'
    printf '%s\n' 'Include = /etc/pacman.d/mirrorlist'
    printf '\n'
    printf '%s\n' '[extra]'
    printf '%s\n' 'Include = /etc/pacman.d/mirrorlist'
    printf '\n'
    printf '%s\n' '[multilib]'
    printf '%s\n' 'Include = /etc/pacman.d/mirrorlist'
    printf '\n'
    printf '[%s]\n' "$repo"
    printf 'Include = %s\n' "$mirror"
  } > "$tmpconf"

  printf '%s\n' "$tmpconf"
}

select_working_profile() {
  local tmpdir="$1"
  local cpu repo repo_path arch_line tmpconf

  while IFS='|' read -r cpu repo repo_path arch_line; do
    rm -rf "$tmpdir/profile-test"
    mkdir -p "$tmpdir/profile-test"
    tmpconf="$(make_temp_pacman "$tmpdir/profile-test" "$repo" "$repo_path" "$arch_line")"

    echo "Testando perfil: CPU=$cpu repo=[$repo] path=$repo_path arch=$arch_line" >&2
    cleanup_sync_dbs

    if pacman --config "$tmpconf" -Syy --noconfirm >/dev/null 2>&1; then
      if pacman --config "$tmpconf" -Sl "$repo" 2>/dev/null | awk -v repo="$repo" '$1==repo && $2=="linux-cachyos" {found=1} END{exit found?0:1}'; then
        CPU_LEVEL="$cpu"
        CACHY_REPO="$repo"
        REPO_PATH="$repo_path"
        ARCH_LINE="$arch_line"
        TMP_CONF="$tmpconf"
        export CPU_LEVEL CACHY_REPO REPO_PATH ARCH_LINE TMP_CONF
        return 0
      fi
    fi
  done < <(candidate_profiles)

  fail "Nenhum repo CachyOS temporário compatível entregou linux-cachyos."
}

installed_version() {
  pacman -Q "$1" 2>/dev/null | awk '{print $2}' || true
}

remote_kernel_version() {
  local pkg="$1"
  pacman --config "$TMP_CONF" -Sl "$CACHY_REPO" 2>/dev/null | awk -v repo="$CACHY_REPO" -v pkg="$pkg" '$1==repo && $2==pkg {print $3; exit}'
}

remote_repo_version() {
  local repo="$1"
  local pkg="$2"
  pacman --config "$TMP_CONF" -Sl "$repo" 2>/dev/null | awk -v repo="$repo" -v pkg="$pkg" '$1==repo && $2==pkg {print $3; exit}'
}

status_for() {
  local installed="$1"
  local remote="$2"

  if [ -z "$installed" ] && [ -z "$remote" ]; then
    echo "indisponível"
  elif [ -z "$installed" ]; then
    echo "ausente"
  elif [ -z "$remote" ]; then
    echo "sem remoto"
  else
    local c
    c="$(vercmp "$remote" "$installed")"
    if [ "$c" -gt 0 ]; then
      echo "atualizar"
    elif [ "$c" -eq 0 ]; then
      echo "em dia"
    else
      echo "instalado > repo"
    fi
  fi
}

append_row() {
  local updates_file="$1"
  local component="$2"
  local pkg="$3"
  local source_kind="$4"
  local source_repo="$5"
  local installed remote status

  installed="$(installed_version "$pkg")"

  case "$source_kind" in
    cachy-kernel) remote="$(remote_kernel_version "$pkg")" ;;
    arch-repo) remote="$(remote_repo_version "$source_repo" "$pkg")" ;;
    *) remote="" ;;
  esac

  status="$(status_for "$installed" "$remote")"

  printf '%-24s %-32s %-22s %-22s %-16s\n' "$component" "$pkg" "${installed:-"-"}" "${remote:-"-"}" "$status"

  if [ "$status" = "atualizar" ] || [ "$status" = "ausente" ]; then
    printf '%s|%s|%s\n' "$pkg" "$source_kind" "$source_repo" >> "$updates_file"
  fi
}

print_report() {
  local updates_file="$1"
  : > "$updates_file"

  local kernel_running="-"
  local nvidia_runtime="-"

  kernel_running="$(uname -r 2>/dev/null || true)"
  [ -n "$kernel_running" ] || kernel_running="-"

  if command -v nvidia-smi >/dev/null 2>&1; then
    nvidia_runtime="$(nvidia-smi --query-gpu=driver_version --format=csv,noheader 2>/dev/null | head -n1 || true)"
    [ -n "$nvidia_runtime" ] || nvidia_runtime="-"
  fi

  echo
  echo "Mocha Stack Optimizer — versões instaladas e disponíveis"
  echo
  echo "Kernel em uso agora: $kernel_running"
  echo "Driver NVIDIA em uso agora: $nvidia_runtime"
  echo
  echo "Perfil detectado:"
  echo "  CPU/repo alvo: $CPU_LEVEL"
  echo "  Repo CachyOS temporário: [$CACHY_REPO]"
  echo "  Caminho remoto: $REPO_PATH"
  echo "  Architecture temporário: $ARCH_LINE"
  echo
  echo "VERSÕES:"
  echo
  printf '%-24s %-32s %-22s %-22s %-16s\n' "Componente" "Pacote" "Versão instalada" "Versão disponível" "Status"
  printf '%s\n' "------------------------------------------------------------------------------------------------------------------------"

  append_row "$updates_file" "Kernel"             "linux-cachyos"             "cachy-kernel" "$CACHY_REPO"
  append_row "$updates_file" "Headers kernel"     "linux-cachyos-headers"     "cachy-kernel" "$CACHY_REPO"
  append_row "$updates_file" "Driver NVIDIA open" "linux-cachyos-nvidia-open" "cachy-kernel" "$CACHY_REPO"
  append_row "$updates_file" "NVIDIA utils"       "nvidia-utils"              "arch-repo"    "extra"
  append_row "$updates_file" "NVIDIA 32-bit"      "lib32-nvidia-utils"        "arch-repo"    "multilib"
  append_row "$updates_file" "NVIDIA settings"    "nvidia-settings"           "arch-repo"    "extra"
  append_row "$updates_file" "OpenCL NVIDIA"      "opencl-nvidia"             "arch-repo"    "extra"

  echo
  echo "Política:"
  echo "  CachyOS é usado somente por pacman.conf temporário."
  echo "  /etc/pacman.conf permanente não recebe repositório CachyOS."
  echo

  if [ -s "$updates_file" ]; then
    echo "RESULTADO=ATUALIZACAO_DISPONIVEL"
    return 10
  fi

  echo "RESULTADO=EM_DIA"
  return 0
}

check_mode() {
  assert_root
  need_cmd pacman
  need_cmd vercmp
  assert_no_permanent_cachyos_repo
  ensure_cachy_key

  local tmpdir updates rc
  tmpdir="$(mktemp -d)"
  trap 'rm -rf "$tmpdir"; cleanup_sync_dbs' EXIT
  updates="$tmpdir/updates.txt"

  log "Detectando repo adequado à CPU e checando versões instaladas/disponíveis"
  select_working_profile "$tmpdir"

  set +e
  print_report "$updates"
  rc="$?"
  set -e

  exit "$rc"
}

update_mode() {
  assert_root
  need_cmd pacman
  need_cmd vercmp
  need_cmd mkinitcpio
  assert_no_permanent_cachyos_repo
  ensure_cachy_key

  local before after tmpdir updates rc
  before="$(sha256sum "$PACMAN_CONF" | awk '{print $1}')"

  tmpdir="$(mktemp -d)"
  trap 'rm -rf "$tmpdir"; cleanup_sync_dbs' EXIT
  updates="$tmpdir/updates.txt"

  log "Detectando repo adequado à CPU"
  select_working_profile "$tmpdir"

  log "Relatório antes da atualização"
  set +e
  print_report "$updates"
  rc="$?"
  set -e

  if [ "$rc" = "0" ]; then
    echo "Nada para atualizar."
    exit 0
  fi

  [ "$rc" = "10" ] || fail "Falha no relatório."

  local install_args=()
  while IFS='|' read -r pkg source_kind source_repo; do
    [ -n "$pkg" ] || continue
    case "$source_kind" in
      cachy-kernel) install_args+=("${CACHY_REPO}/${pkg}") ;;
      arch-repo) install_args+=("${source_repo}/${pkg}") ;;
    esac
  done < "$updates"

  [ "${#install_args[@]}" -gt 0 ] || fail "Relatório indicou atualização, mas lista de instalação está vazia."

  log "Instalando apenas pacotes necessários"
  printf '  %s\n' "${install_args[@]}"
  pacman --config "$TMP_CONF" -S --needed --noconfirm "${install_args[@]}"

  log "Regenerando initramfs"
  mkinitcpio -P

  log "Atualizando GRUB, se existir"
  if command -v grub-mkconfig >/dev/null 2>&1 && [ -d /boot/grub ]; then
    grub-mkconfig -o /boot/grub/grub.cfg
  else
    echo "GRUB não detectado em /boot/grub; pulando."
  fi

  cleanup_sync_dbs

  after="$(sha256sum "$PACMAN_CONF" | awk '{print $1}')"
  [ "$before" = "$after" ] || fail "/etc/pacman.conf foi alterado. Proibido."

  assert_no_permanent_cachyos_repo

  log "Relatório final"
  select_working_profile "$tmpdir"
  print_report "$updates" || true

  echo
  echo "OK: CachyOS não ficou permanente."
  echo "Reinicie para usar o kernel novo."
}

reinstall_mode() {
  assert_root
  need_cmd pacman
  need_cmd vercmp
  need_cmd mkinitcpio
  assert_no_permanent_cachyos_repo
  ensure_cachy_key

  local before after tmpdir updates
  before="$(sha256sum "$PACMAN_CONF" | awk '{print $1}')"

  tmpdir="$(mktemp -d)"
  trap 'rm -rf "$tmpdir"; cleanup_sync_dbs' EXIT
  updates="$tmpdir/updates.txt"

  log "Detectando repo adequado à CPU para reinstalar/recasar stack completa"
  select_working_profile "$tmpdir"

  log "Relatório antes da reinstalação"
  print_report "$updates" || true

  log "Reinstalando stack completa de kernel e driver"
  echo "Ação: reinstalação forçada para reparar/recasar pacotes."
  echo "Repo CachyOS temporário: [$CACHY_REPO]"
  echo "Pacman.conf permanente não será alterado."

  pacman --config "$TMP_CONF" -S --noconfirm \
    "${CACHY_REPO}/linux-cachyos" \
    "${CACHY_REPO}/linux-cachyos-headers" \
    "${CACHY_REPO}/linux-cachyos-nvidia-open" \
    extra/nvidia-utils \
    multilib/lib32-nvidia-utils \
    extra/nvidia-settings \
    extra/opencl-nvidia

  log "Regenerando initramfs"
  mkinitcpio -P

  log "Atualizando GRUB, se existir"
  if command -v grub-mkconfig >/dev/null 2>&1 && [ -d /boot/grub ]; then
    grub-mkconfig -o /boot/grub/grub.cfg
  else
    echo "GRUB não detectado em /boot/grub; pulando."
  fi

  cleanup_sync_dbs

  after="$(sha256sum "$PACMAN_CONF" | awk '{print $1}')"
  [ "$before" = "$after" ] || fail "/etc/pacman.conf foi alterado. Proibido."

  assert_no_permanent_cachyos_repo

  log "Relatório final depois da reinstalação"
  select_working_profile "$tmpdir"
  print_report "$updates" || true

  echo
  echo "OK: stack kernel/driver reinstalada e recasada."
  echo "Reinicie para garantir que kernel, initramfs e módulo NVIDIA carreguem limpos."
}

case "$MODE" in
  check) check_mode ;;
  update) update_mode ;;
  reinstall) reinstall_mode ;;
  *) echo "Uso: $0 {check|update|reinstall}" >&2; exit 2 ;;
esac
