-- Wrapper atual --
     1	#!/usr/bin/env bash
     2	set -Eeuo pipefail
     3	
     4	# MOCHA — wrapper de jogo Steam
     5	# Não altera driver de vídeo.
     6	# Não usa vkBasalt.
     7	# Não usa gamescope.
     8	# Não usa MANGOHUD_DLSYM.
     9	
    10	export MANGOHUD=1
    11	export MANGOHUD_CONFIGFILE="${MANGOHUD_CONFIGFILE:-$HOME/.config/MangoHud/Mocha-MangoHud-FPS-Comparacao.conf}"
    12	export DXVK_LOG_LEVEL="${DXVK_LOG_LEVEL:-none}"
    13	
    14	if command -v gamemoderun >/dev/null 2>&1 && command -v mangohud >/dev/null 2>&1; then
    15	  exec gamemoderun mangohud "$@"
    16	elif command -v mangohud >/dev/null 2>&1; then
    17	  exec mangohud "$@"
    18	elif command -v gamemoderun >/dev/null 2>&1; then
    19	  exec gamemoderun "$@"
    20	else
    21	  exec "$@"
    22	fi

