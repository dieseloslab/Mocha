# >>> MOCHAARCH GITHUB SAFETY IGNORE >>>
# Segredos e chaves
.ssh/
**/.ssh/
**/id_rsa
**/id_rsa.*
**/id_ed25519
**/id_ed25519.*
**/*.pem
**/*.key
**/*.p12
**/*.pfx
**/.env
**/.env.*

# Tokens/senhas por nome de arquivo
**/*token*
**/*secret*
**/*senha*
**/*password*

# Quarentena, backups locais e cópias operacionais
_QUARENTENA/
quarentena/
**/_QUARENTENA/
**/quarentena/
**/backups/
**/*.bak
**/*.old
**/*.orig
**/*.tmp

# Máquinas virtuais, ISOs e imagens brutas
**/*.qcow2
**/*.vdi
**/*.vmdk
**/*.raw
**/*.iso
**/*.img
**/*.ova
**/*.ovf

# Caches e builds locais
**/.cache/
**/cache/
**/Cache/
**/node_modules/
**/__pycache__/
**/*.pyc
**/pkg/
**/src/
**/pacman-cache/
**/var-cache-pacman/

# Lixo local
.Trash-*/
**/.Trash-*/
**/*~
# <<< MOCHAARCH GITHUB SAFETY IGNORE <<<

MOCHA_CALAMARES_EXCLUDES_BEGIN
*.bak-*
*.backup-*
*.bkp-*
ativo/*.bak-*
ativo/*.backup-*
ativo/*.bkp-*
calamares/aur/*/src/
calamares/aur/*/pkg/
calamares/aur/*/*.pkg.tar.*
calamares/aur/*/*.pkg.tar.*.sig
calamares/aur/*/build/
MOCHA_CALAMARES_EXCLUDES_END
calamares/origem-calam-arch-installer-*/usr/lib/calamares/libcalamares.so
calamares/origem-calam-arch-installer-*/usr/lib64/calamares/libcalamares.so
calamares/trabalho-mocha-calamares-*/usr/lib/calamares/libcalamares.so
calamares/trabalho-mocha-calamares-*/usr/lib64/calamares/libcalamares.so

# MochaArch/Calamares: payloads gerados localmente
calamares/payloads/

calamares/testes/

calamares/aplicacoes/

calamares/mocha-calamares/propostas/

calamares/mocha-calamares/staging/

calamares/mocha-calamares/reports/

calamares/overlays/
