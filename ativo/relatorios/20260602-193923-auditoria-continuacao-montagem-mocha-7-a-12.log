f1a51b7276a724a4bac3e45bbd20e439c0f005be0624836b0f6b2ea25869cdbe  /home/hal/.local/bin/mocha-steam-game-run
#!/usr/bin/env bash
set -Eeuo pipefail

# Mocha — wrapper canônico Steam/Proton.
# Mantém Wayland no desktop, mas evita Wine/Proton Wayland nativo para preservar compatibilidade.
# Sem gamescope, sem vkbasalt, sem MANGOHUD_DLSYM.

unset XMODIFIERS
unset GTK_IM_MODULE
unset QT_IM_MODULE
unset GLFW_IM_MODULE

export PROTON_ENABLE_WAYLAND=0
export PROTON_USE_WAYLAND=0
export SDL_VIDEO_MINIMIZE_ON_FOCUS_LOSS=0

# Não forçar SDL_VIDEODRIVER aqui: alguns jogos/engines pioram se SDL for travado globalmente.
# A correção principal agora fica no registro do prefixo Proton/Wine:
# HKCU\Software\Wine\X11 Driver\UseTakeFocus=N
# HKCU\Software\Wine\DirectInput\MouseWarpOverride=force

if command -v gamemoderun >/dev/null 2>&1; then
  exec gamemoderun "$@"
else
  exec "$@"
fi

-- verificação de itens proibidos fora de comentário --
OK: wrapper sem gamescope/vkbasalt/MANGOHUD_DLSYM executável

