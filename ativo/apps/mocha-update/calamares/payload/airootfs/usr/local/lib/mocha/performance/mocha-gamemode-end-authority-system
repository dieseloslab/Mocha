#!/usr/bin/env bash
set +e
export LC_ALL=C

LEGACY_CMD_FILE="/etc/mocha/gamemode/legacy-end-system.cmd"
LOG="/tmp/mocha-gamemode-authority-${USER:-unknown}.log"

log() {
    printf '%s %s\n' "$(date '+%F %T')" "$*" >> "$LOG" 2>/dev/null || true
}

run_legacy() {
    [ -s "$LEGACY_CMD_FILE" ] || {
        log "legacy end ausente ou vazio: $LEGACY_CMD_FILE"
        return 0
    }

    cmd="$(sed -n '1p' "$LEGACY_CMD_FILE" 2>/dev/null || true)"

    [ -n "$cmd" ] || {
        log "legacy end sem comando"
        return 0
    }

    case "$cmd" in
        *mocha-gamemode-start-authority*|*mocha-gamemode-end-authority*)
            log "legacy end recusado para evitar recursão: $cmd"
            return 0
            ;;
    esac

    log "executando legacy end: $cmd"
    /bin/bash -lc "$cmd" >> "$LOG" 2>&1 ||
        log "legacy end retornou falha"
}

log "GameMode end authority system V2"

run_legacy


exit 0
