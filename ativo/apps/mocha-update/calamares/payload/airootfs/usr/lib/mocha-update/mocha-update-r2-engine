#!/usr/bin/env bash
set -Eeuo pipefail

export LC_ALL=C
export LANG=C
export PAGER=cat
export SYSTEMD_PAGER=cat
umask 077

readonly R2_EXPECTED_BASE='https://updates.dieseloslab.org'
readonly R2_EXPECTED_CHANNEL='stable'
readonly CONFIG_DEFAULT='/etc/mocha-update/update-endpoint.conf'
readonly ALLOWLIST_DEFAULT='/etc/mocha-update/update-components-v1.json'
readonly STATE_DEFAULT='/var/lib/mocha-update/installed-components-v1.json'
readonly CHECK_DEFAULT='/usr/lib/mocha-update/mocha-update-r2-check'
readonly KEYRING_DEFAULT='/usr/share/mocha-update/keys/mocha-release-signing.gpg'
readonly ROOT_CACHE='/var/cache/mocha-update/r2'
readonly ROOT_BACKUPS='/var/lib/mocha-update/r2-backups'
readonly LOCK_FILE='/run/lock/mocha-update-r2.lock'
readonly MAX_SIGNATURE_BYTES=262144
readonly MAX_ARTIFACT_BYTES=8589934592
readonly USER_AGENT='Mocha-Update-R2-Engine/1'

MODE=''
WORK=''
TRANSACTION=''
STATE_BACKUP=''
ROLLBACK_RECORDS=''
TRANSACTION_ACTIVE=0

cleanup() {
    local rc=$?
    trap - EXIT INT TERM HUP ERR
    if [[ -n "$WORK" && -d "$WORK" ]]; then
        rm -rf -- "$WORK"
    fi
    exit "$rc"
}

rollback_transaction() {
    local original_rc=$?
    trap - ERR
    if (( TRANSACTION_ACTIVE == 1 )); then
        printf 'R2_ROLLBACK=INICIADO\n' >&2
        if [[ -s "$ROLLBACK_RECORDS" ]]; then
            tac -- "$ROLLBACK_RECORDS" | while IFS='|' read -r kind release_dir launcher backup_dir; do
                case "$kind" in
                    application)
                        if [[ -f "$backup_dir/new-files.bin" ]]; then
                            while IFS= read -r -d '' path; do
                                rm -f -- "$path" 2>/dev/null || true
                            done < "$backup_dir/new-files.bin"
                        fi
                        if [[ -d "$backup_dir/rootfs" ]]; then
                            rsync -aH -- "$backup_dir/rootfs/" / 2>/dev/null || true
                        fi
                        ;;
                    component)
                        if [[ -n "$launcher" ]]; then
                            if [[ -e "$backup_dir/launcher" || -L "$backup_dir/launcher" ]]; then
                                rm -f -- "$launcher" 2>/dev/null || true
                                cp -a -- "$backup_dir/launcher" "$launcher" 2>/dev/null || true
                            else
                                rm -f -- "$launcher" 2>/dev/null || true
                            fi
                        fi
                        ;;
                    content|release)
                        ;;
                esac
                [[ -z "$release_dir" ]] || rm -rf -- "$release_dir" 2>/dev/null || true
            done
        fi
        if [[ -n "$STATE_BACKUP" && -f "$STATE_BACKUP" ]]; then
            install -o root -g root -m 0644 -- "$STATE_BACKUP" "$STATE_DEFAULT" 2>/dev/null || true
        fi
        sync 2>/dev/null || true
        printf 'R2_ROLLBACK=CONCLUIDO\n' >&2
    fi
    exit "$original_rc"
}

trap cleanup EXIT
trap 'exit 130' INT
trap 'exit 143' TERM
trap 'exit 129' HUP

fail() {
    printf 'R2_RESULT=FAILURE\n' >&2
    printf 'R2_ERROR=%s\n' "$*" >&2
    return 1
}

require_file() {
    local path="$1" label="$2"
    [[ -f "$path" && ! -L "$path" && -r "$path" ]] ||
        fail "$label ausente ou não confiável: $path"
}

require_command() {
    local command="$1"
    command -v "$command" >/dev/null 2>&1 || fail "comando obrigatório ausente: $command"
}

user_cache() {
    local base
    if [[ -n "${XDG_CACHE_HOME:-}" ]]; then
        base="$XDG_CACHE_HOME"
    elif [[ -n "${HOME:-}" ]]; then
        base="$HOME/.cache"
    else
        fail 'HOME e XDG_CACHE_HOME estão ausentes'
        return 1
    fi
    printf '%s/mocha-update/r2\n' "$base"
}

validate_pinned_config() {
    local config="$1" checker="$2" output base channel keyring
    output="$($checker --validate-config "$config")" || fail 'configuração R2 inválida'
    base="$(awk -F= '$1=="BASE_URL" {print substr($0,index($0,"=")+1)}' <<<"$output")"
    channel="$(awk -F= '$1=="CHANNEL" {print substr($0,index($0,"=")+1)}' <<<"$output")"
    keyring="$(awk -F= '$1=="RELEASE_KEYRING" {print substr($0,index($0,"=")+1)}' <<<"$output")"
    [[ "$base" == "$R2_EXPECTED_BASE" ]] || fail "BASE_URL divergente: $base"
    [[ "$channel" == "$R2_EXPECTED_CHANNEL" ]] || fail "CHANNEL divergente: $channel"
    [[ "$keyring" == "$KEYRING_DEFAULT" ]] || fail "keyring divergente: $keyring"
    printf '%s\t%s\t%s\n' "$base" "$channel" "$keyring"
}

secure_download() {
    local url="$1" destination="$2" maximum="$3"
    curl \
        --fail \
        --silent \
        --show-error \
        --location \
        --max-redirs 3 \
        --proto '=https' \
        --proto-redir '=https' \
        --tlsv1.2 \
        --connect-timeout 15 \
        --max-time 900 \
        --retry 2 \
        --retry-delay 1 \
        --retry-connrefused \
        --max-filesize "$maximum" \
        --user-agent "$USER_AGENT" \
        --output "$destination" \
        -- "$url" || fail "falha ao baixar: $url"
    [[ -s "$destination" ]] || fail "download vazio: $url"
    [[ "$(stat -c '%s' "$destination")" -le "$maximum" ]] ||
        fail "download excedeu o limite: $url"
}

reject_kernel_scope() {
    local id="$1"
    case "$id" in
        *kernel*|*nvidia*|linux-*|*-headers|*-firmware)
            fail "componente proibido no catálogo geral R2: $id"
            ;;
    esac
}

validate_archive_paths() {
    local archive="$1" listing="$2"
    bsdtar -tf "$archive" > "$listing" || fail 'artefato não é um arquivo tar válido'
    python3 - "$listing" <<'PY'
from pathlib import PurePosixPath
import sys

entries = []
for raw in open(sys.argv[1], encoding="utf-8", errors="strict"):
    name = raw.rstrip("\n")
    if not name:
        raise SystemExit("entrada vazia no artefato")
    if any(ord(c) < 32 or ord(c) == 127 for c in name):
        raise SystemExit("entrada com caractere de controle")
    if name.startswith("/") or "\\" in name:
        raise SystemExit(f"entrada absoluta ou inválida: {name}")
    path = PurePosixPath(name)
    if any(part in {"", ".", ".."} for part in path.parts):
        raise SystemExit(f"entrada insegura: {name}")
    if not path.parts or path.parts[0] != "payload":
        raise SystemExit(f"entrada fora de payload/: {name}")
    entries.append(name)
if not entries:
    raise SystemExit("artefato vazio")
PY
}

extract_archive() {
    local archive="$1" destination="$2"
    local listing="$destination/listing.txt"
    mkdir -p -m 0700 -- "$destination"
    validate_archive_paths "$archive" "$listing"
    (
        umask 022
        bsdtar --no-same-owner -xf "$archive" -C "$destination"
    ) || fail 'falha ao extrair artefato'
    [[ -d "$destination/payload" && ! -L "$destination/payload" ]] ||
        fail 'diretório payload ausente no artefato'
    if find "$destination/payload" -xdev \( -type l -o -type b -o -type c -o -type p -o -type s \) -print -quit | grep -q .; then
        fail 'artefato contém link ou arquivo especial não autorizado'
    fi
}

run_validator() {
    local allowlist="$1" id="$2" payload="$3"
    python3 - "$allowlist" "$id" "$payload" <<'PY'
import json
from pathlib import Path
import subprocess
import sys

allow_path, component_id, payload = sys.argv[1:]
data = json.loads(Path(allow_path).read_text(encoding="utf-8"))
entry = next((x for x in data.get("components", []) if x.get("id") == component_id), None)
if entry is None:
    raise SystemExit(f"componente ausente na allowlist: {component_id}")
validator = entry.get("validator")
if not isinstance(validator, list) or not validator or not all(isinstance(x, str) and x for x in validator):
    raise SystemExit("validador inválido")
args = [part.replace("{payload}", payload) for part in validator]
if any("{payload}" in part for part in args):
    raise SystemExit("placeholder de payload não resolvido")
result = subprocess.run(args, env={"PATH": "/usr/local/sbin:/usr/local/bin:/usr/bin"})
if result.returncode != 0:
    raise SystemExit(f"validador retornou {result.returncode}")
PY
}

component_contract() {
    local allowlist="$1" id="$2"
    python3 - "$allowlist" "$id" <<'PY'
import json
from pathlib import Path
import sys

path, component_id = sys.argv[1:]
data = json.loads(Path(path).read_text(encoding="utf-8"))
entry = next((x for x in data.get("components", []) if x.get("id") == component_id), None)
if entry is None:
    raise SystemExit(f"componente ausente na allowlist: {component_id}")
values = [
    entry.get("kind", ""),
    entry.get("install_root", ""),
    entry.get("launcher") or "",
    "true" if entry.get("requires_root") is True else "false",
]
if any("|" in value or "\n" in value for value in values):
    raise SystemExit("campo inválido na allowlist")
print("|".join(values))
PY
}

catalog_records() {
    local catalog="$1" decisions="$2" output="$3"
    python3 - "$catalog" "$decisions" > "$output" <<'PY'
import json
from pathlib import Path
import re
import sys

catalog_path, decisions_path = sys.argv[1:]
catalog = json.loads(Path(catalog_path).read_text(encoding="utf-8"))
install_ids = set()
for line in Path(decisions_path).read_text(encoding="utf-8").splitlines():
    if not line.startswith("ITEM|"):
        continue
    fields = {}
    for field in line.split("|")[1:]:
        key, sep, value = field.partition("=")
        if sep:
            fields[key] = value
    if fields.get("DECISAO") == "INSTALL":
        install_ids.add(fields.get("ID", ""))

items = {item.get("id"): item for item in catalog.get("items", [])}
for component_id in sorted(install_ids):
    item = items.get(component_id)
    if item is None:
        raise SystemExit(f"decisão sem item no catálogo: {component_id}")
    values = [
        component_id,
        str(item.get("kind", "")),
        str(item.get("version", "")),
        str(item.get("artifact", "")),
        str(item.get("sha256", "")),
        str(item.get("size", "")),
        "true" if item.get("requires_app_restart") is True else "false",
        "true" if item.get("requires_reboot") is True else "false",
    ]
    if any("\t" in value or "\n" in value for value in values):
        raise SystemExit("campo de catálogo inválido")
    if not re.fullmatch(r"[0-9]+", values[5]):
        raise SystemExit("tamanho inválido")
    print("\t".join(values))
PY
}

update_state() {
    local state="$1" id="$2" version="$3"
    python3 - "$state" "$id" "$version" <<'PY'
import json
import os
from pathlib import Path
import sys

path = Path(sys.argv[1])
component_id = sys.argv[2]
version = sys.argv[3]
data = json.loads(path.read_text(encoding="utf-8"))
if data.get("schema") != 1 or not isinstance(data.get("components"), dict):
    raise SystemExit("estado instalado inválido")
data["components"][component_id] = version
tmp = path.with_name(f".{path.name}.new.{os.getpid()}")
tmp.write_text(json.dumps(data, indent=2, sort_keys=True) + "\n", encoding="utf-8")
os.chmod(tmp, 0o644)
os.replace(tmp, path)
PY
    chown root:root -- "$state"
}

validate_application_rootfs() {
    local rootfs="$1"
    python3 - "$rootfs" <<'PY'
from pathlib import Path, PurePosixPath
import sys

root = Path(sys.argv[1])
allowed_exact = {
    PurePosixPath("usr/bin/mocha-update"),
    PurePosixPath("usr/share/applications/org.mocha.update.desktop"),
    PurePosixPath("usr/share/polkit-1/actions/org.mocha.update.policy"),
}
allowed_prefixes = (
    PurePosixPath("usr/lib/mocha-update"),
    PurePosixPath("etc/mocha-update"),
    PurePosixPath("usr/share/mocha-update"),
    PurePosixPath("usr/share/icons/hicolor"),
)
files = [path for path in root.rglob("*") if path.is_file()]
if not files:
    raise SystemExit("rootfs da aplicação vazio")
for path in files:
    rel = PurePosixPath(path.relative_to(root).as_posix())
    allowed = rel in allowed_exact or any(rel == prefix or prefix in rel.parents for prefix in allowed_prefixes)
    if not allowed:
        raise SystemExit(f"destino não autorizado no rootfs da aplicação: /{rel}")
    lower = rel.as_posix().lower()
    if rel == PurePosixPath("etc/mocha-update/installed-components-v1.json"):
        raise SystemExit("o artefato não pode sobrescrever o estado instalado")
    if any(token in lower for token in ("kernel", "nvidia", "modules/", "pacman.conf", "pacman.d/", "boot/")):
        raise SystemExit(f"destino relacionado a kernel/driver proibido: /{rel}")
required = root / "usr/bin/mocha-update"
if not required.is_file():
    raise SystemExit("rootfs não contém usr/bin/mocha-update")
PY
}

install_application() {
    local id="$1" version="$2" payload="$3" install_root="$4" release_dir="$5" backup_dir="$6"
    local rootfs="$payload/rootfs"
    [[ -d "$rootfs" && ! -L "$rootfs" ]] || fail "rootfs ausente para $id"
    validate_application_rootfs "$rootfs"

    install -d -o root -g root -m 0700 "$backup_dir/rootfs"
    : > "$backup_dir/new-files.bin"
    while IFS= read -r -d '' source; do
        local rel destination
        rel="${source#"$rootfs"/}"
        destination="/$rel"
        if [[ -e "$destination" || -L "$destination" ]]; then
            rsync -aR -- "$destination" "$backup_dir/rootfs/"
        else
            printf '%s\0' "$destination" >> "$backup_dir/new-files.bin"
        fi
    done < <(find "$rootfs" -xdev -type f -print0 | sort -z)

    printf 'application|||%s\n' "$backup_dir" >> "$ROLLBACK_RECORDS"
    rsync -aH --chown=0:0 -- "$rootfs/" /
    /usr/bin/mocha-update --self-test >/dev/null
}

install_component_or_content() {
    local kind="$1" id="$2" payload="$3" release_dir="$4" launcher="$5" backup_dir="$6"
    if [[ "$kind" == component ]]; then
        [[ -n "$launcher" ]] || fail "launcher ausente para componente $id"
        local candidate="$release_dir/$(basename -- "$launcher")"
        [[ -f "$candidate" && -x "$candidate" ]] ||
            fail "launcher não encontrado no payload de $id: $(basename -- "$launcher")"
        install -d -o root -g root -m 0700 "$backup_dir"
        if [[ -e "$launcher" || -L "$launcher" ]]; then
            cp -a -- "$launcher" "$backup_dir/launcher"
        fi
        install -d -o root -g root -m 0755 "$(dirname -- "$launcher")"
        printf 'component||%s|%s\n' "$launcher" "$backup_dir" >> "$ROLLBACK_RECORDS"
        ln -s -- "$candidate" "${launcher}.new.$$"
        mv -Tf -- "${launcher}.new.$$" "$launcher"
    elif [[ -n "$launcher" ]]; then
        fail "conteúdo $id não pode possuir launcher"
    fi
}

prepare_release() {
    local payload="$1" install_root="$2" version="$3" sha="$4"
    local release_dir="$install_root/${version}-${sha:0:12}"
    local new_dir="$install_root/.${version}-${sha:0:12}.new.$$"
    install -d -o root -g root -m 0755 "$install_root"
    [[ ! -e "$release_dir" ]] || fail "release já existe: $release_dir"
    install -d -o root -g root -m 0755 "$new_dir"
    rsync -aH --chown=0:0 -- "$payload/" "$new_dir/"
    mv -- "$new_dir" "$release_dir"
    printf '%s\n' "$release_dir"
}

run_check() {
    local cache="$1" config="$2" allowlist="$3" state="$4" checker="$5"
    local result="$WORK/check-result.txt"
    "$checker" --remote "$config" "$allowlist" "$state" "$cache" x86_64 > "$result"
    grep -Fxq 'RESULTADO=SUCESSO' "$result" || fail 'cliente R2 não retornou sucesso'
    local count summary restart reboot
    count="$(grep -c '^ITEM|.*|DECISAO=INSTALL|' "$result" || true)"
    restart=NAO
    reboot=NAO
    grep -q '^ITEM|.*|DECISAO=INSTALL|.*|REINICIA_APP=SIM|' "$result" && restart=SIM || true
    grep -q '^ITEM|.*|DECISAO=INSTALL|.*|REINICIA_SISTEMA=SIM|' "$result" && reboot=SIM || true
    if (( count == 0 )); then
        summary='catálogo R2 stable autenticado; nenhum componente geral novo disponível'
    else
        local items
        items="$(awk -F'|' '            /^ITEM\|/ {                id=""; version=""; decision="";                for (i=2; i<=NF; i++) {                    split($i, pair, "=");                    if (pair[1] == "ID") id=substr($i, index($i, "=")+1);                    if (pair[1] == "DISPONIVEL") version=substr($i, index($i, "=")+1);                    if (pair[1] == "DECISAO") decision=substr($i, index($i, "=")+1);                }                if (decision == "INSTALL") {                    if (printed++) printf ", ";                    printf "%s %s", id, version;                }            }            END { print "" }' "$result")"
        summary="R2 stable autenticado: $items"
    fi
    printf 'R2_RESULT=SUCCESS\n'
    printf 'R2_BASE_URL=%s\n' "$R2_EXPECTED_BASE"
    printf 'R2_CHANNEL=%s\n' "$R2_EXPECTED_CHANNEL"
    printf 'R2_AVAILABLE_COUNT=%s\n' "$count"
    printf 'R2_SUMMARY=%s\n' "$summary"
    printf 'R2_RESTART_APP=%s\n' "$restart"
    printf 'R2_REBOOT=%s\n' "$reboot"
}

run_apply() {
    (( EUID == 0 )) || fail 'apply exige root'
    local config="$1" allowlist="$2" state="$3" checker="$4"
    require_command flock
    exec 9>"$LOCK_FILE"
    flock -n 9 || fail 'outra transação R2 está em execução'

    install -d -o root -g root -m 0755 "$(dirname -- "$state")" "$ROOT_CACHE" "$ROOT_BACKUPS"
    if [[ ! -f "$state" ]]; then
        printf '{\n  "schema": 1,\n  "components": {"mocha-update": "%s"}\n}\n' \
            "$(/usr/bin/mocha-update --self-test | awk -F= '$1=="VERSION" {print $2}')" > "$state"
        chown root:root "$state"
        chmod 0644 "$state"
    fi
    require_file "$state" 'estado instalado'

    local result="$WORK/apply-check-result.txt"
    "$checker" --remote "$config" "$allowlist" "$state" "$ROOT_CACHE" x86_64 > "$result"
    grep -Fxq 'RESULTADO=SUCESSO' "$result" || fail 'consulta autenticada R2 falhou'

    local records="$WORK/install-records.tsv"
    catalog_records "$ROOT_CACHE/catalog-v1.json" "$result" "$records"
    local total
    total="$(wc -l < "$records")"
    if (( total == 0 )); then
        printf 'R2_RESULT=SUCCESS\n'
        printf 'R2_INSTALLED_COUNT=0\n'
        printf 'R2_SUMMARY=catálogo R2 stable autenticado; nenhum componente geral novo para instalar\n'
        printf 'R2_RESTART_APP=NAO\n'
        printf 'R2_REBOOT=NAO\n'
        return 0
    fi

    TRANSACTION="$(date '+%Y%m%d-%H%M%S')-$$"
    local transaction_dir="$ROOT_BACKUPS/$TRANSACTION"
    install -d -o root -g root -m 0700 "$transaction_dir"
    STATE_BACKUP="$transaction_dir/installed-components-v1.json.before"
    cp -a -- "$state" "$STATE_BACKUP"
    ROLLBACK_RECORDS="$transaction_dir/rollback-records.tsv"
    : > "$ROLLBACK_RECORDS"
    TRANSACTION_ACTIVE=1
    trap rollback_transaction ERR

    local base channel keyring
    IFS=$'\t' read -r base channel keyring < <(validate_pinned_config "$config" "$checker")
    local frozen_allowlist="$WORK/allowlist-frozen.json"
    local frozen_keyring="$WORK/keyring-frozen.gpg"
    cp -- "$allowlist" "$frozen_allowlist"
    cp -- "$keyring" "$frozen_keyring"
    chmod 0600 "$frozen_allowlist" "$frozen_keyring"
    local installed_count=0 restart=NAO reboot=NAO

    while IFS=$'\t' read -r id catalog_kind version artifact sha expected_size restart_flag reboot_flag; do
        reject_kernel_scope "$id"
        local contract kind install_root launcher requires_root
        contract="$(component_contract "$frozen_allowlist" "$id")"
        IFS='|' read -r kind install_root launcher requires_root <<< "$contract"
        [[ "$kind" == "$catalog_kind" ]] || fail "kind divergente para $id"
        [[ "$requires_root" == true ]] || fail "componente remoto sem requires_root: $id"
        [[ "$expected_size" -gt 0 && "$expected_size" -le "$MAX_ARTIFACT_BYTES" ]] ||
            fail "tamanho inválido para $id"

        local item_dir="$WORK/item-$installed_count"
        mkdir -p -m 0700 "$item_dir"
        local artifact_file="$item_dir/artifact.tar"
        local signature_file="$item_dir/artifact.tar.asc"
        local artifact_url="${base%/}/$artifact"
        local signature_url="${artifact_url}.asc"
        secure_download "$artifact_url" "$artifact_file" "$expected_size"
        secure_download "$signature_url" "$signature_file" "$MAX_SIGNATURE_BYTES"
        [[ "$(stat -c '%s' "$artifact_file")" == "$expected_size" ]] ||
            fail "tamanho baixado diverge do catálogo para $id"
        gpgv --keyring "$frozen_keyring" "$signature_file" "$artifact_file" >/dev/null 2>&1 ||
            fail "assinatura do artefato inválida para $id"
        printf '%s  %s\n' "$sha" "$artifact_file" | sha256sum --check --strict - >/dev/null ||
            fail "SHA-256 do artefato inválido para $id"

        local extraction="$item_dir/extracted"
        extract_archive "$artifact_file" "$extraction"
        local payload="$extraction/payload"
        run_validator "$frozen_allowlist" "$id" "$payload"

        local release_dir backup_dir
        release_dir="$(prepare_release "$payload" "$install_root" "$version" "$sha")"
        printf 'release|%s||\n' "$release_dir" >> "$ROLLBACK_RECORDS"
        backup_dir="$transaction_dir/$id"
        install -d -o root -g root -m 0700 "$backup_dir"
        if [[ "$kind" == application ]]; then
            install_application "$id" "$version" "$payload" "$install_root" "$release_dir" "$backup_dir"
        else
            install_component_or_content "$kind" "$id" "$payload" "$release_dir" "$launcher" "$backup_dir"
        fi
        update_state "$state" "$id" "$version"
        installed_count=$((installed_count + 1))
        [[ "$restart_flag" == true ]] && restart=SIM
        [[ "$reboot_flag" == true ]] && reboot=SIM
    done < "$records"

    sync
    TRANSACTION_ACTIVE=0
    trap - ERR
    printf 'R2_RESULT=SUCCESS\n'
    printf 'R2_TRANSACTION=%s\n' "$TRANSACTION"
    printf 'R2_INSTALLED_COUNT=%s\n' "$installed_count"
    printf 'R2_SUMMARY=%s componente(s) geral(is) instalado(s) a partir do R2 stable\n' "$installed_count"
    printf 'R2_RESTART_APP=%s\n' "$restart"
    printf 'R2_REBOOT=%s\n' "$reboot"
}

run_self_test() {
    require_command python3
    require_command bsdtar
    require_command sha256sum
    local test_dir
    test_dir="$(mktemp -d)"
    mkdir -p "$test_dir/source/payload"
    printf '{"ok":true}\n' > "$test_dir/source/payload/support.json"
    bsdtar -cf "$test_dir/valid.tar" -C "$test_dir/source" payload
    extract_archive "$test_dir/valid.tar" "$test_dir/extracted"
    [[ -f "$test_dir/extracted/payload/support.json" ]] || fail 'self-test de extração falhou'
    if reject_kernel_scope 'linux-mocha-lqx' >/dev/null 2>&1; then
        fail 'self-test de separação do kernel falhou'
    fi
    rm -rf -- "$test_dir"
    printf 'R2_RESULT=SUCCESS\n'
    printf 'R2_SELF_TEST=SUCCESS\n'
    printf 'R2_BASE_URL=%s\n' "$R2_EXPECTED_BASE"
    printf 'R2_CHANNEL=%s\n' "$R2_EXPECTED_CHANNEL"
}

main() {
    MODE="${1:-}"
    [[ $# -eq 1 ]] || fail 'uso: mocha-update-r2-engine check|apply|self-test'

    for command in awk bsdtar curl find gpgv grep install python3 rsync sha256sum sort stat sync tac; do
        require_command "$command"
    done

    WORK="$(mktemp -d)"
    case "$MODE" in
        check)
            require_file "$CONFIG_DEFAULT" 'configuração R2'
            require_file "$ALLOWLIST_DEFAULT" 'allowlist R2'
            require_file "$STATE_DEFAULT" 'estado instalado'
            require_file "$CHECK_DEFAULT" 'cliente R2'
            validate_pinned_config "$CONFIG_DEFAULT" "$CHECK_DEFAULT" >/dev/null
            local cache
            cache="$(user_cache)"
            mkdir -p -m 0700 -- "$cache"
            run_check "$cache" "$CONFIG_DEFAULT" "$ALLOWLIST_DEFAULT" "$STATE_DEFAULT" "$CHECK_DEFAULT"
            ;;
        apply)
            require_file "$CONFIG_DEFAULT" 'configuração R2'
            require_file "$ALLOWLIST_DEFAULT" 'allowlist R2'
            require_file "$CHECK_DEFAULT" 'cliente R2'
            require_file "$KEYRING_DEFAULT" 'keyring R2'
            validate_pinned_config "$CONFIG_DEFAULT" "$CHECK_DEFAULT" >/dev/null
            run_apply "$CONFIG_DEFAULT" "$ALLOWLIST_DEFAULT" "$STATE_DEFAULT" "$CHECK_DEFAULT"
            ;;
        self-test)
            run_self_test
            ;;
        *)
            fail 'uso: mocha-update-r2-engine check|apply|self-test'
            ;;
    esac
}

main "$@"
