#!/usr/bin/env bash
# Mocha Steam Game Wrapper — canônico
# Uso oficial nas opções de inicialização da Steam:
# /usr/local/bin/mocha-steam-game-run %command%

set -u

if [ "$#" -eq 0 ]; then
  printf "%s\n" "Uso: /usr/local/bin/mocha-steam-game-run %command%" >&2
  exit 64
fi

# Correção principal contra perda de input/foco ao usar Alt+Tab.
export SDL_VIDEO_MINIMIZE_ON_FOCUS_LOSS=0
export WINE_MOUSE_WARP_OVERRIDE=force

# Não usar camadas que já causaram conflito no Mocha.
unset MANGOHUD_DLSYM
unset ENABLE_VKBASALT
unset VKBASALT_CONFIG_FILE

# Nunca sobrescrever configuração do MangoHud inline no wrapper.
unset MANGOHUD_CONFIG

# Configuração canônica do MangoHud, se existir.
MOCHA_MANGOHUD_CONF="/usr/local/share/mocha/mangohud/MangoHud.conf"
if [ -r "$MOCHA_MANGOHUD_CONF" ]; then
  export MANGOHUD_CONFIGFILE="$MOCHA_MANGOHUD_CONF"
fi

# Chamada normal, como distro normal: mangohud antes do comando do jogo.
if command -v mangohud >/dev/null 2>&1; then
  exec mangohud "$@"
fi

# Fallback seguro caso MangoHud não esteja instalado.
exec "$@"

