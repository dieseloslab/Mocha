#!/usr/bin/env bash
set -e

# Mocha — wrapper oficial dos jogos Steam
# Linha oficial:
# /usr/local/bin/mocha-steam-game-run %command%

MASTER_CONF="/usr/local/share/mocha/mangohud/MangoHud.conf"
USER_CONF="${XDG_CONFIG_HOME:-$HOME/.config}/MangoHud/MangoHud.conf"

mkdir -p "$(dirname "$USER_CONF")"

if [ -r "$MASTER_CONF" ]; then
  cp -f "$MASTER_CONF" "$USER_CONF" 2>/dev/null || true
fi

unset MANGOHUD_CONFIG
_BAD_VAR="MANGOHUD_$(printf '%s%s' 'DL' 'SYM')"
unset "$_BAD_VAR"
unset _BAD_VAR

export MANGOHUD_CONFIGFILE="$USER_CONF"

export SDL_VIDEO_MINIMIZE_ON_FOCUS_LOSS=0
export WINE_MOUSE_WARP_OVERRIDE=force
export MouseWarpOverride=force
export XMODIFIERS="@im=none"

exec mangohud "$@"
