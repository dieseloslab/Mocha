#!/usr/bin/env bash
# Mocha Steam Game Wrapper — sem MangoHud/overlay
# Linha oficial na Steam:
# /usr/local/bin/mocha-steam-game-run %command%

set -u

if [ "$#" -eq 0 ]; then
  printf "%s\n" "Uso: /usr/local/bin/mocha-steam-game-run %command%" >&2
  exit 64
fi

# Mitigação de foco/input ao alternar janela.
export SDL_VIDEO_MINIMIZE_ON_FOCUS_LOSS=0
export WINE_MOUSE_WARP_OVERRIDE=force

# Remove overlay/config herdado.
unset MANGOHUD
unset MANGOHUD_CONFIG
unset MANGOHUD_CONFIGFILE
unset MANGOHUD_DLSYM

unset ENABLE_VKBASALT
unset VKBASALT_CONFIG_FILE

exec "$@"

