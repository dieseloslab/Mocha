--- Shim ---
#!/usr/bin/env bash
set -Eeuo pipefail

CONF="/usr/local/share/mocha/mangohud/MangoHud.conf"
REAL="/usr/bin/mangohud"

export MANGOHUD=1
export MANGOHUD_CONFIGFILE="$CONF"

# Fix de foco/input por ambiente. Não edita Steam. Não edita Proton.
export SDL_VIDEO_MINIMIZE_ON_FOCUS_LOSS=0
export WINE_MOUSE_WARP_OVERRIDE=force
export MouseWarpOverride=force

# Bloqueia sobrescrita externa do layout Mocha.
unset MANGOHUD_CONFIG
unset MANGOHUD_DLSYM

exec "$REAL" "$@"

--- Wrapper ---
#!/usr/bin/env bash
set -Eeuo pipefail

export MANGOHUD=1
export MANGOHUD_CONFIGFILE="/usr/local/share/mocha/mangohud/MangoHud.conf"

export SDL_VIDEO_MINIMIZE_ON_FOCUS_LOSS=0
export WINE_MOUSE_WARP_OVERRIDE=force
export MouseWarpOverride=force

unset MANGOHUD_CONFIG
unset MANGOHUD_DLSYM
unset ENABLE_VKBASALT
unset VKBASALT_CONFIG_FILE
unset GAMESCOPE_WSI
unset ENABLE_GAMESCOPE_WSI

if command -v gamemoderun >/dev/null 2>&1; then
  exec gamemoderun /usr/local/bin/mangohud "$@"
else
  exec /usr/local/bin/mangohud "$@"
fi

