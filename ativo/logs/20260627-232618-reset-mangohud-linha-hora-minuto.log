Wrapper:
------------------------------------------------------------
#!/usr/bin/env bash
set -e

# Mocha — wrapper oficial Steam
# Linha oficial nas opções de inicialização dos jogos:
# /usr/local/bin/mocha-steam-game-run %command%

export MANGOHUD=1
export MANGOHUD_CONFIGFILE="/usr/local/share/mocha/mangohud/MangoHud.conf"

export SDL_VIDEO_MINIMIZE_ON_FOCUS_LOSS=0
export MouseWarpOverride=force

if command -v gamemoderun >/dev/null 2>&1; then
  exec gamemoderun mangohud "$@"
fi

exec mangohud "$@"
