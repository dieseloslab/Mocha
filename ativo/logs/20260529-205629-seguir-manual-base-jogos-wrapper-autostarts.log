Wrapper:
-rwxr-xr-x 1 hal hal 736 mai 29 20:57 /home/hal/.local/bin/mocha-steam-game-run
#!/usr/bin/env bash
set -Eeuo pipefail

export MANGOHUD=1
export MANGOHUD_CONFIGFILE="${MANGOHUD_CONFIGFILE:-$HOME/.config/MangoHud/Mocha-MangoHud-FPS-Comparacao.conf}"
unset MANGOHUD_DLSYM
unset ENABLE_VKBASALT
unset VKBASALT_CONFIG_FILE
unset __NV_PRIME_RENDER_OFFLOAD
unset __VK_LAYER_NV_optimus
unset DRI_PRIME

if [ "$#" -eq 0 ]; then
  printf "%s\n" "Uso Steam Launch Options: /home/hal/.local/bin/mocha-steam-game-run %command%" >&2
  exit 64
fi

if command -v gamemoderun >/dev/null 2>&1 && command -v mangohud >/dev/null 2>&1; then
  exec gamemoderun mangohud "$@"
elif command -v mangohud >/dev/null 2>&1; then
  exec mangohud "$@"
elif command -v gamemoderun >/dev/null 2>&1; then
  exec gamemoderun "$@"
else
  exec "$@"
fi

