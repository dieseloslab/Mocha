--- /usr/bin/mangohud ---
#!/usr/bin/env bash
# MOCHA-MANGOHUD-SHIM
set -Eeuo pipefail

CONF="/usr/local/share/mocha/mangohud/MangoHud.conf"
REAL="/usr/lib/mocha/mangohud/mangohud-real"

export MANGOHUD=1
export MANGOHUD_CONFIGFILE="$CONF"

# Fix de foco/input por ambiente. Não edita Steam. Não edita Proton.
export SDL_VIDEO_MINIMIZE_ON_FOCUS_LOSS=0
export WINE_MOUSE_WARP_OVERRIDE=force
export MouseWarpOverride=force

# Impede layout externo sobrescrever o arquivo Mocha.
unset MANGOHUD_CONFIG
unset MANGOHUD_DLSYM

exec "$REAL" "$@"

