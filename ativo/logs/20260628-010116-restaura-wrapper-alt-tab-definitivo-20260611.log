#!/usr/bin/env bash
set -Eeuo pipefail

if [ "$#" -eq 0 ]; then
    echo "ERRO: nenhum comando de jogo foi recebido." >&2
    exit 64
fi

export PROTON_ENABLE_WAYLAND=0
export PROTON_USE_WAYLAND=0
export SDL_VIDEO_MINIMIZE_ON_FOCUS_LOSS=0

corrigir_prefixo_proton() {
    local compat_data
    local prefixo
    local user_reg
    local marcador
    local lockfile
    local proton=""
    local argumento
    local resultado=0

    compat_data="${STEAM_COMPAT_DATA_PATH:-}"

    if [ -z "$compat_data" ]; then
        return 0
    fi

    prefixo="$compat_data/pfx"
    user_reg="$prefixo/user.reg"
    marcador="$compat_data/.mocha-input-fix-v1"
    lockfile="$compat_data/.mocha-input-fix.lock"

    for argumento in "$@"; do
        case "$argumento" in
            */proton)
                if [ -x "$argumento" ]; then
                    proton="$argumento"
                    break
                fi
                ;;
        esac
    done

    if [ -z "$proton" ]; then
        return 0
    fi

    mkdir -p "$compat_data"

    exec 9>"$lockfile"

    if ! flock -w 30 9; then
        echo "AVISO: não foi possível obter o bloqueio do prefixo Proton." >&2
        return 0
    fi

    valor_registro_presente() {
        local arquivo="$1"
        local secao="$2"
        local nome="$3"
        local valor="$4"

        [ -r "$arquivo" ] || return 1

        awk \
            -v secao="$secao" \
            -v procurado="\"$nome\"=\"$valor\"" '
                index($0, "[" secao "]") == 1 {
                    dentro=1
                    next
                }

                dentro && /^\[/ {
                    dentro=0
                }

                dentro && $0 == procurado {
                    encontrado=1
                }

                END {
                    exit encontrado ? 0 : 1
                }
            ' "$arquivo"
    }

    if valor_registro_presente \
           "$user_reg" \
           'Software\\Wine\\X11 Driver' \
           'UseTakeFocus' \
           'N' &&
       valor_registro_presente \
           "$user_reg" \
           'Software\\Wine\\DirectInput' \
           'MouseWarpOverride' \
           'force'; then
        touch "$marcador"
        return 0
    fi

    echo "MochaArch: aplicando correção automática de input ao prefixo Proton." >&2

    if ! timeout 60s "$proton" run reg.exe add \
        'HKCU\Software\Wine\X11 Driver' \
        /v UseTakeFocus \
        /t REG_SZ \
        /d N \
        /f >/dev/null 2>&1; then
        resultado=1
    fi

    if ! timeout 60s "$proton" run reg.exe add \
        'HKCU\Software\Wine\DirectInput' \
        /v MouseWarpOverride \
        /t REG_SZ \
        /d force \
        /f >/dev/null 2>&1; then
        resultado=1
    fi

    if [ "$resultado" -eq 0 ]; then
        touch "$marcador"
    else
        echo "AVISO: a correção automática do prefixo não foi concluída; o jogo será iniciado normalmente." >&2
    fi

    return 0
}

corrigir_prefixo_proton "$@"

if command -v gamemoderun >/dev/null 2>&1; then
    exec gamemoderun "$@"
fi

exec "$@"

