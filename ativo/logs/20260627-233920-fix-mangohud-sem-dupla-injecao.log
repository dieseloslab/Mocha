Wrapper:
------------------------------------------------------------
#!/usr/bin/env bash
set -e

# Mocha — wrapper oficial dos jogos Steam
# Linha oficial:
# /usr/local/bin/mocha-steam-game-run %command%

# Não usar MANGOHUD=1 aqui.
# O wrapper chama mangohud diretamente, como distro normal.
# Isso evita dupla injeção via Steam Runtime + mangohud.

export MANGOHUD_CONFIGFILE="/usr/local/share/mocha/mangohud/MangoHud.conf"

# Proteção de input/foco em Alt+Tab.
export SDL_VIDEO_MINIMIZE_ON_FOCUS_LOSS=0
export WINE_MOUSE_WARP_OVERRIDE=force
export MouseWarpOverride=force
export XMODIFIERS="@im=none"

exec mangohud "$@"
