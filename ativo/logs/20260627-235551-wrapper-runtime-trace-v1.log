#!/usr/bin/env bash
set -Eeuo pipefail

MASTER_CONF="/usr/local/share/mocha/mangohud/MangoHud.conf"
USER_CONF="${XDG_CONFIG_HOME:-$HOME/.config}/MangoHud/MangoHud.conf"
RUNTIME_DIR="${HOME}/.local/share/mocha/runtime"
RUNTIME_LOG="${RUNTIME_DIR}/mocha-steam-game-run.log"

mkdir -p "$(dirname "$USER_CONF")" "$RUNTIME_DIR"

{
  echo "============================================================"
  echo "Mocha wrapper chamado"
  echo "Data: $(date '+%Y-%m-%d %H:%M:%S')"
  echo "UID: $(id -u)"
  echo "USER: ${USER:-}"
  echo "HOME: ${HOME:-}"
  echo "PWD: ${PWD:-}"
  echo "Args count: $#"
  printf 'Args:'
  for arg in "$@"; do
    printf ' [%s]' "$arg"
  done
  printf '\n'
  echo "MASTER_CONF: $MASTER_CONF"
  echo "USER_CONF: $USER_CONF"
  echo "mangohud path: $(command -v mangohud 2>/dev/null || true)"
} >> "$RUNTIME_LOG" 2>&1 || true

if [ -r "$MASTER_CONF" ]; then
  cp -f "$MASTER_CONF" "$USER_CONF" 2>/dev/null || true
fi

unset MANGOHUD_CONFIG
_BAD_VAR="MANGOHUD_$(printf '%s%s' 'DL' 'SYM')"
unset "$_BAD_VAR" 2>/dev/null || true
unset _BAD_VAR

export MANGOHUD=1
export MANGOHUD_CONFIGFILE="$USER_CONF"

export SDL_VIDEO_MINIMIZE_ON_FOCUS_LOSS=0
export WINE_MOUSE_WARP_OVERRIDE=force
export MouseWarpOverride=force
export XMODIFIERS="@im=none"

{
  echo "MANGOHUD=$MANGOHUD"
  echo "MANGOHUD_CONFIGFILE=$MANGOHUD_CONFIGFILE"
  echo "Exec final: mangohud <Steam command>"
  echo
} >> "$RUNTIME_LOG" 2>&1 || true

exec mangohud "$@"
