--- Wrapper ---
export MANGOHUD_CONFIGFILE="$CANON_CONF"
export MANGOHUD_CONFIG="legacy_layout=false,horizontal,hud_no_margin,position=top-left,font_size=20,round_corners=8,background_alpha=0.42,alpha=1.0,background_color=1e1512,text_color=f4e4d4,gpu_color=d08a5b,cpu_color=c67a4a,vram_color=e0a070,frametime_color=f4c49a,engine_color=f4e4d4,wine_color=f4e4d4,fps,cpu_stats,gpu_stats,vram,ram,time,time_format=%H:%M,gamemode,frame_timing=0,histogram=0,toggle_hud=Shift_R+F12,toggle_logging=Shift_L+F2,upload_log=0,output_folder=/tmp"
export SDL_VIDEO_MINIMIZE_ON_FOCUS_LOSS=0
export WINE_MOUSE_WARP_OVERRIDE=force
export MouseWarpOverride=force
  exec gamemoderun mangohud "$@"
  exec mangohud "$@"

--- MangoHud.conf ---
# Sem gráfico de frametime.
legacy_layout=false
horizontal
vram_color=e0a070
frametime_color=f4c49a
fps
cpu_stats
gpu_stats
vram
ram
time
time_format=%H:%M
gamemode
frame_timing=0
histogram=0

