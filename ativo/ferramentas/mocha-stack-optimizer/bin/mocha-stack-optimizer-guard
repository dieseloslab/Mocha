#!/usr/bin/env bash
set -Eeuo pipefail

if locale -a 2>/dev/null | grep -qx 'C\.UTF-8'; then
    export LC_ALL=C.UTF-8
else
    export LC_ALL=C
fi

CORE="/usr/local/bin/mocha-stack-optimizer-core"

fail_contaminado() {
    echo "ERRO: canal CachyOS permanente detectado."
    echo
    echo "O Mocha pode usar CachyOS apenas via pacman.conf temporário."
    echo "Não pode existir bloco [cachyos...] ativo em /etc/pacman.conf."
    echo
    echo "Abortado para impedir contaminação da instalação."
    exit 1
}

audita_pacman_conf_limpo() {
    if grep -qE '^[[:space:]]*\[cachyos[^]]*\]' /etc/pacman.conf; then
        grep -nE '^[[:space:]]*\[cachyos[^]]*\]' /etc/pacman.conf || true
        fail_contaminado
    fi

    if grep -qiE 'cachyos.*mirrorlist|cachyos-[a-z0-9_-]*-mirrorlist' /etc/pacman.conf; then
        grep -nEi 'cachyos.*mirrorlist|cachyos-[a-z0-9_-]*-mirrorlist' /etc/pacman.conf || true
        fail_contaminado
    fi
}

audita_tmp_apenas() {
    find /tmp -maxdepth 1 -type f -name 'mocha-stack-optimizer-pacman-*.conf' -print 2>/dev/null | while IFS= read -r f; do
        if grep -qE '^[[:space:]]*\[cachyos[^]]*\]' "$f"; then
            :
        fi
    done
}

if [ ! -x "$CORE" ]; then
    echo "ERRO: núcleo do otimizador não encontrado: $CORE"
    exit 1
fi

audita_pacman_conf_limpo

"$CORE" "$@"
RC="$?"

audita_pacman_conf_limpo
audita_tmp_apenas

echo
echo "Auditoria final Mocha:"
echo " - Canal CachyOS permanente: AUSENTE"
echo " - /etc/pacman.conf: limpo"
echo " - Keyring/mirrorlists CachyOS: permitidos, pois não ativam canal sozinhos"

exit "$RC"
