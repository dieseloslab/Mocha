[Desktop Entry]
Type=Application
Name=Mocha Stack Optimizer
GenericName=Mocha Kernel and Driver Optimizer
Comment=Mostra kernel/driver atual e disponível, detecta arquitetura e casa NVIDIA
Exec=konsole --hold -e /usr/local/bin/mocha-firstboot-stack
Icon=preferences-system-performance
Terminal=false
Categories=System;Settings;Utility;
StartupNotify=true
