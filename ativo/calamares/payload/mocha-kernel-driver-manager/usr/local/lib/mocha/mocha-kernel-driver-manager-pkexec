#!/usr/bin/env bash
set -Eeuo pipefail
export LC_ALL=C
export MOCHA_KERNEL_DRIVER_MANAGER_ELEVATED=1

REAL="/usr/local/bin/mocha-kernel-driver-manager"

if [ "$(id -u)" -ne 0 ]; then
  echo "[FALHA] Este alvo deve ser executado via pkexec/root." >&2
  exit 1
fi

if [ -n "${PKEXEC_UID:-}" ]; then
  export XDG_RUNTIME_DIR="/run/user/$PKEXEC_UID"
  [ -S "$XDG_RUNTIME_DIR/wayland-0" ] && export WAYLAND_DISPLAY="wayland-0"
  [ -z "${DISPLAY:-}" ] && export DISPLAY=":0"
fi

exec "$REAL" "$@"
