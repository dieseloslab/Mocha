#!/usr/bin/env bash

# Mocha — MangoHud rollback horizontal
export MANGOHUD=1
export MANGOHUD_CONFIG='legacy_layout=0,horizontal,hud_no_margin,position=top-left,font_size=20,round_corners=0,background_alpha=0.35,fps,frametime,frame_timing=0,histogram=0,cpu_stats,gpu_stats,ram,vram,time,time_format=%R,time_no_label,gamemode'
# Mocha — Steam wrapper canônico
# MangoHud via Vulkan layer: evita layout padrão/extended do comando mangohud.

CONF="/usr/local/share/mocha/mangohud/MangoHud.conf"
CORE="/usr/local/lib/mocha/mocha-steam-game-run-alt-tab-core"


export SDL_VIDEO_MINIMIZE_ON_FOCUS_LOSS=0
export WINE_MOUSE_WARP_OVERRIDE=force

if [ -x "$CORE" ]; then
  exec "$CORE" "$@"
fi

exec "$@"
