#!/usr/bin/env bash
set -u

ACTION="${1:-status}"
CONF="/etc/mocha/nvidia-game-oc.conf"
LOG="/var/log/mocha-nvidia-game-oc.log"

mkdir -p /var/log

CORE_OFFSET=50
MEMORY_TRANSFER_RATE_OFFSET=250
GPU_INDEX=0

if [ -f "$CONF" ]; then
  # shellcheck disable=SC1090
  . "$CONF"
fi

log() {
  printf '%s %s\n' "$(date '+%F %T')" "$*" >> "$LOG"
}

case "$ACTION" in
  start|apply|end|reset|stop|status) ;;
  *)
    echo "uso: $0 start|end|status" >&2
    exit 2
    ;;
esac

python3 - "$ACTION" "$GPU_INDEX" "$CORE_OFFSET" "$MEMORY_TRANSFER_RATE_OFFSET" <<'PY' 2>&1 | tee -a /var/log/mocha-nvidia-game-oc.log
import ctypes
import sys
import os
import time

action = sys.argv[1]
gpu_index = int(sys.argv[2])
core_offset = int(sys.argv[3])
mem_offset = int(sys.argv[4])

def load_nvml():
    last = None
    for name in ("libnvidia-ml.so.1", "libnvidia-ml.so"):
        try:
            return ctypes.CDLL(name), name
        except OSError as e:
            last = e
    raise RuntimeError(f"não carregou libnvidia-ml: {last}")

nvml, libname = load_nvml()

def get_symbol(name, required=True):
    try:
        return getattr(nvml, name)
    except AttributeError:
        if required:
            raise RuntimeError(f"símbolo NVML ausente: {name}")
        return None

error_string = get_symbol("nvmlErrorString", required=False)
if error_string is not None:
    error_string.argtypes = [ctypes.c_int]
    error_string.restype = ctypes.c_char_p

def err_name(code):
    if code == 0:
        return "NVML_SUCCESS"
    if error_string is not None:
        try:
            s = error_string(code)
            if s:
                return s.decode("utf-8", "replace")
        except Exception:
            pass
    return f"NVML_ERROR_{code}"

def check(code, what):
    if code != 0:
        raise RuntimeError(f"{what}: {err_name(code)} ({code})")

init = get_symbol("nvmlInit_v2", required=False) or get_symbol("nvmlInit")
shutdown = get_symbol("nvmlShutdown", required=False)
get_handle = get_symbol("nvmlDeviceGetHandleByIndex_v2", required=False) or get_symbol("nvmlDeviceGetHandleByIndex")

set_gpc = get_symbol("nvmlDeviceSetGpcClkVfOffset")
set_mem = get_symbol("nvmlDeviceSetMemClkVfOffset")

get_gpc = get_symbol("nvmlDeviceGetGpcClkVfOffset", required=False)
get_mem = get_symbol("nvmlDeviceGetMemClkVfOffset", required=False)

init.restype = ctypes.c_int
get_handle.argtypes = [ctypes.c_uint, ctypes.POINTER(ctypes.c_void_p)]
get_handle.restype = ctypes.c_int

set_gpc.argtypes = [ctypes.c_void_p, ctypes.c_int]
set_gpc.restype = ctypes.c_int
set_mem.argtypes = [ctypes.c_void_p, ctypes.c_int]
set_mem.restype = ctypes.c_int

if get_gpc is not None:
    get_gpc.argtypes = [ctypes.c_void_p, ctypes.POINTER(ctypes.c_int)]
    get_gpc.restype = ctypes.c_int
if get_mem is not None:
    get_mem.argtypes = [ctypes.c_void_p, ctypes.POINTER(ctypes.c_int)]
    get_mem.restype = ctypes.c_int

print("================================================================")
print(time.strftime("%F %T"), f"NVML action={action} lib={libname} gpu_index={gpu_index} uid={os.geteuid()}")

check(init(), "nvmlInit")

dev = ctypes.c_void_p()
check(get_handle(ctypes.c_uint(gpu_index), ctypes.byref(dev)), "nvmlDeviceGetHandleByIndex")

def query(label):
    if get_gpc is not None:
        v = ctypes.c_int()
        r = get_gpc(dev, ctypes.byref(v))
        print(f"{label}_GPC_OFFSET={v.value if r == 0 else err_name(r)}")
    else:
        print(f"{label}_GPC_OFFSET_QUERY=simbolo_ausente")

    if get_mem is not None:
        v = ctypes.c_int()
        r = get_mem(dev, ctypes.byref(v))
        print(f"{label}_MEM_OFFSET={v.value if r == 0 else err_name(r)}")
    else:
        print(f"{label}_MEM_OFFSET_QUERY=simbolo_ausente")

query("BEFORE")

if action in ("start", "apply"):
    check(set_gpc(dev, ctypes.c_int(core_offset)), f"nvmlDeviceSetGpcClkVfOffset={core_offset}")
    check(set_mem(dev, ctypes.c_int(mem_offset)), f"nvmlDeviceSetMemClkVfOffset={mem_offset}")
    print(f"NVML_START_OK core={core_offset} mem={mem_offset}")
    query("AFTER")

elif action in ("end", "reset", "stop"):
    check(set_gpc(dev, ctypes.c_int(0)), "nvmlDeviceSetGpcClkVfOffset=0")
    check(set_mem(dev, ctypes.c_int(0)), "nvmlDeviceSetMemClkVfOffset=0")
    print("NVML_END_OK core=0 mem=0")
    query("AFTER")

elif action == "status":
    print("NVML_STATUS_OK")
    query("STATUS")

if shutdown is not None:
    shutdown()
PY

RC="${PIPESTATUS[0]}"

if [ "$RC" -ne 0 ]; then
  log "ERRO: helper NVML action=$ACTION rc=$RC"
  exit "$RC"
fi
