#!/usr/bin/env bash
set -u

ACTION="${1:-status}"
CONF="/etc/mocha/nvidia-game-oc.conf"
LOG="/var/log/mocha-nvidia-game-oc.log"

GPU_INDEX=0
CORE_OFFSET=50
MEMORY_TRANSFER_RATE_OFFSET=400

[ -f "$CONF" ] && . "$CONF"

mkdir -p /var/log

case "$ACTION" in
  start|apply|end|reset|stop|status) ;;
  *)
    echo "uso: $0 start|end|status" >&2
    exit 2
    ;;
esac

log() {
  printf '%s %s\n' "$(date '+%F %T')" "$*" >> "$LOG"
}

detect_target_user() {
  if [ -n "${SUDO_USER:-}" ] && [ "${SUDO_USER:-root}" != "root" ]; then
    printf '%s\n' "$SUDO_USER"
    return 0
  fi

  if [ -n "${MOCHA_TARGET_USER:-}" ]; then
    printf '%s\n' "$MOCHA_TARGET_USER"
    return 0
  fi

  loginctl list-users --no-legend 2>/dev/null | awk '$2 != "root" {print $2; exit}'
}

TARGET_USER="$(detect_target_user)"
TARGET_UID="$(id -u "$TARGET_USER" 2>/dev/null || printf '')"

find_env_value() {
  key="$1"

  if [ -z "${TARGET_USER:-}" ]; then
    return 1
  fi

  for pid in $(pgrep -u "$TARGET_USER" -f 'plasmashell|kwin_wayland|ksmserver|steam|Xwayland|gamescope|Heroic|legendary|faugus' 2>/dev/null | head -40); do
    [ -r "/proc/$pid/environ" ] || continue
    value="$(tr '\0' '\n' < "/proc/$pid/environ" 2>/dev/null | awk -F= -v k="$key" '$1 == k {print substr($0, length(k) + 2); exit}')"
    if [ -n "$value" ]; then
      printf '%s\n' "$value"
      return 0
    fi
  done

  return 1
}

DISPLAY_USE="${DISPLAY:-}"
XAUTHORITY_USE="${XAUTHORITY:-}"
WAYLAND_DISPLAY_USE="${WAYLAND_DISPLAY:-}"
XDG_RUNTIME_DIR_USE="${XDG_RUNTIME_DIR:-}"

if [ -z "$DISPLAY_USE" ]; then
  DISPLAY_USE="$(find_env_value DISPLAY 2>/dev/null || true)"
fi

if [ -z "$XAUTHORITY_USE" ]; then
  XAUTHORITY_USE="$(find_env_value XAUTHORITY 2>/dev/null || true)"
fi

if [ -z "$WAYLAND_DISPLAY_USE" ]; then
  WAYLAND_DISPLAY_USE="$(find_env_value WAYLAND_DISPLAY 2>/dev/null || true)"
fi

if [ -z "$XDG_RUNTIME_DIR_USE" ]; then
  XDG_RUNTIME_DIR_USE="$(find_env_value XDG_RUNTIME_DIR 2>/dev/null || true)"
fi

if [ -z "$XDG_RUNTIME_DIR_USE" ] && [ -n "$TARGET_UID" ] && [ -d "/run/user/$TARGET_UID" ]; then
  XDG_RUNTIME_DIR_USE="/run/user/$TARGET_UID"
fi

if [ -z "$XAUTHORITY_USE" ] && [ -n "$XDG_RUNTIME_DIR_USE" ] && [ -d "$XDG_RUNTIME_DIR_USE" ]; then
  XAUTHORITY_USE="$(find "$XDG_RUNTIME_DIR_USE" -maxdepth 1 -type f -name 'xauth_*' 2>/dev/null | head -1 || true)"
fi

if [ -z "$DISPLAY_USE" ]; then
  for d in :1 :0; do
    sock="/tmp/.X11-unix/X${d#:}"
    if [ -S "$sock" ]; then
      DISPLAY_USE="$d"
      break
    fi
  done
fi

export DISPLAY="$DISPLAY_USE"
[ -n "$XAUTHORITY_USE" ] && export XAUTHORITY="$XAUTHORITY_USE"
[ -n "$WAYLAND_DISPLAY_USE" ] && export WAYLAND_DISPLAY="$WAYLAND_DISPLAY_USE"
[ -n "$XDG_RUNTIME_DIR_USE" ] && export XDG_RUNTIME_DIR="$XDG_RUNTIME_DIR_USE"

{
  printf '\n'
  printf '================================================================\n'
  printf '%s NVC action=%s target_user=%s uid=%s gpu=%s core=%s mem=%s\n' "$(date '+%F %T')" "$ACTION" "${TARGET_USER:-}" "${TARGET_UID:-}" "$GPU_INDEX" "$CORE_OFFSET" "$MEMORY_TRANSFER_RATE_OFFSET"
  printf 'DISPLAY=%s\n' "${DISPLAY:-}"
  printf 'XAUTHORITY=%s\n' "${XAUTHORITY:-}"
  printf 'WAYLAND_DISPLAY=%s\n' "${WAYLAND_DISPLAY:-}"
  printf 'XDG_RUNTIME_DIR=%s\n' "${XDG_RUNTIME_DIR:-}"
} >> "$LOG"

if ! command -v nvidia-settings >/dev/null 2>&1; then
  log "ERRO: nvidia-settings ausente"
  exit 127
fi

if [ -z "${DISPLAY:-}" ]; then
  log "ERRO: DISPLAY nao detectado para NV-CONTROL"
  exit 10
fi

run_ns() {
  log "nvidia-settings $*"
  nvidia-settings "$@" 2>&1 | tee -a "$LOG"
  return "${PIPESTATUS[0]}"
}

query_state() {
  run_ns \
    -q "[gpu:${GPU_INDEX}]/GPUPowerMizerMode" \
    -q "[gpu:${GPU_INDEX}]/GPUGraphicsClockOffsetAllPerformanceLevels" \
    -q "[gpu:${GPU_INDEX}]/GPUMemoryTransferRateOffsetAllPerformanceLevels" \
    -q "[gpu:${GPU_INDEX}]/GPUCurrentClockFreqsString"
}

RC=0

case "$ACTION" in
  start|apply)
    run_ns -a "[gpu:${GPU_INDEX}]/GPUPowerMizerMode=1" || true
    run_ns -a "[gpu:${GPU_INDEX}]/GPUGraphicsClockOffsetAllPerformanceLevels=${CORE_OFFSET}" || RC=1
    run_ns -a "[gpu:${GPU_INDEX}]/GPUMemoryTransferRateOffsetAllPerformanceLevels=${MEMORY_TRANSFER_RATE_OFFSET}" || RC=1
    query_state || true

    if [ "$RC" -eq 0 ]; then
      echo "NVC_START_OK core=${CORE_OFFSET} mem=${MEMORY_TRANSFER_RATE_OFFSET}"
      log "NVC_START_OK core=${CORE_OFFSET} mem=${MEMORY_TRANSFER_RATE_OFFSET}"
    else
      echo "NVC_START_FAIL core=${CORE_OFFSET} mem=${MEMORY_TRANSFER_RATE_OFFSET}" >&2
      log "ERRO: NVC_START_FAIL core=${CORE_OFFSET} mem=${MEMORY_TRANSFER_RATE_OFFSET}"
      exit "$RC"
    fi
    ;;
  end|reset|stop)
    run_ns -a "[gpu:${GPU_INDEX}]/GPUGraphicsClockOffsetAllPerformanceLevels=0" || RC=1
    run_ns -a "[gpu:${GPU_INDEX}]/GPUMemoryTransferRateOffsetAllPerformanceLevels=0" || RC=1
    run_ns -a "[gpu:${GPU_INDEX}]/GPUPowerMizerMode=0" || true
    query_state || true

    if [ "$RC" -eq 0 ]; then
      echo "NVC_END_OK core=0 mem=0"
      log "NVC_END_OK core=0 mem=0"
    else
      echo "NVC_END_FAIL" >&2
      log "ERRO: NVC_END_FAIL"
      exit "$RC"
    fi
    ;;
  status)
    query_state
    echo "NVC_STATUS_OK"
    log "NVC_STATUS_OK"
    ;;
esac
