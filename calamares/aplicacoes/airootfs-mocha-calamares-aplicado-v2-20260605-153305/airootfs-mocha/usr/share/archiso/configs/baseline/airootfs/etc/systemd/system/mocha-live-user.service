[Unit]
Description=Mocha Live user, passwordless sudo and direct Plasma Wayland live session
After=local-fs.target systemd-sysusers.service
Before=display-manager.service sddm.service

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/mocha-live-user-ensure
RemainAfterExit=yes

[Install]
WantedBy=graphical.target
