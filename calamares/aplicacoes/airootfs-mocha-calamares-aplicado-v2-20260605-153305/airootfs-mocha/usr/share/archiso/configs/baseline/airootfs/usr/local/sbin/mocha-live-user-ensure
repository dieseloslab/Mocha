#!/usr/bin/env bash
set -Eeuo pipefail

LIVE_USER="${MOCHA_LIVE_USER:-mocha}"
LIVE_REALNAME="${MOCHA_LIVE_REALNAME:-Mocha Live}"
MOCHA_THEME="/usr/share/sddm/themes/mocha"
MOCHA_BG="$MOCHA_THEME/mocha-background.png"

SESSION=""
for s in plasmawayland.desktop org.kde.plasma.desktop plasma.desktop; do
    if [ -f "/usr/share/wayland-sessions/$s" ]; then
        SESSION="$s"
        break
    fi
done

if [ -z "$SESSION" ]; then
    SESSION="plasma.desktop"
fi

if [ -d /usr/share/sddm/themes/breeze ]; then
    mkdir -p "$MOCHA_THEME"
    cp -a /usr/share/sddm/themes/breeze/. "$MOCHA_THEME"/ 2>/dev/null || true
    if [ -f "$MOCHA_BG" ]; then
        printf "%s\n" "[General]" "background=$MOCHA_BG" "type=image" > "$MOCHA_THEME/theme.conf.user"
    fi
    if [ -f "$MOCHA_THEME/metadata.desktop" ]; then
        sed -i "s/^Name=.*/Name=Mocha/" "$MOCHA_THEME/metadata.desktop" 2>/dev/null || true
    fi
fi

if ! getent group wheel >/dev/null 2>&1; then
    groupadd wheel
fi

SUPP_GROUPS=""
for g in wheel video audio input storage optical power network lp scanner; do
    if getent group "$g" >/dev/null 2>&1; then
        if [ -n "$SUPP_GROUPS" ]; then
            SUPP_GROUPS="${SUPP_GROUPS},${g}"
        else
            SUPP_GROUPS="$g"
        fi
    fi
done

if ! id "$LIVE_USER" >/dev/null 2>&1; then
    if [ -n "$SUPP_GROUPS" ]; then
        useradd -m -s /bin/bash -c "$LIVE_REALNAME" -G "$SUPP_GROUPS" "$LIVE_USER"
    else
        useradd -m -s /bin/bash -c "$LIVE_REALNAME" "$LIVE_USER"
    fi
else
    usermod -s /bin/bash "$LIVE_USER" >/dev/null 2>&1 || true
    if [ -n "$SUPP_GROUPS" ]; then
        usermod -aG "$SUPP_GROUPS" "$LIVE_USER" >/dev/null 2>&1 || true
    fi
fi

passwd -d "$LIVE_USER" >/dev/null 2>&1 || true

mkdir -p /etc/sudoers.d
printf "%s\n" "%wheel ALL=(ALL:ALL) NOPASSWD: ALL" > /etc/sudoers.d/00-mocha-live-wheel-nopasswd
chmod 0440 /etc/sudoers.d/00-mocha-live-wheel-nopasswd

mkdir -p /etc/sddm.conf.d
printf "%s\n" "[Autologin]" "User=${LIVE_USER}" "Session=${SESSION}" "Relogin=true" "" "[General]" "DisplayServer=wayland" "" "[Theme]" "Current=mocha" > /etc/sddm.conf.d/10-mocha-live-autologin.conf

mkdir -p /var/lib/AccountsService/users /var/lib/AccountsService/icons
if [ -f /var/lib/AccountsService/icons/mocha ]; then
    printf "%s\n" "[User]" "Icon=/var/lib/AccountsService/icons/mocha" "SystemAccount=false" > "/var/lib/AccountsService/users/${LIVE_USER}" || true
fi

if [ -f /etc/skel/.face.icon ]; then
    install -D -m 0644 /etc/skel/.face.icon "/home/${LIVE_USER}/.face.icon" || true
fi

if [ -f /etc/xdg/autostart/mocha-calamares.desktop ]; then
    mkdir -p "/home/${LIVE_USER}/Desktop"
    install -m 0755 /etc/xdg/autostart/mocha-calamares.desktop "/home/${LIVE_USER}/Desktop/Instalar Mocha.desktop" || true
    chown -R "${LIVE_USER}:${LIVE_USER}" "/home/${LIVE_USER}/Desktop" || true
fi

chown -R "${LIVE_USER}:${LIVE_USER}" "/home/${LIVE_USER}" >/dev/null 2>&1 || true

exit 0
